      "segment_id": "E42_S1_011",
      "scene_number": 1,
      "kind": "camera",
      "label": "CAMERA",
      "speaker": null,
      "delivery": null,
      "start": "00:21.50",
      "end": "00:23.40",
      "start_seconds": 21.5,
      "end_seconds": 23.4,
      "duration_seconds": 1.9,
      "text": "Medium shot of the royal guardsman standing rigidly in red uniform and bearskin cap, resting his white-gloved hand on his sabre.",
      "source_line": 54
    },
    {
      "segment_id": "E42_S1_012",
      "scene_number": 1,
      "kind": "dialogue",
      "label": "ROYAL GUARD (Stoic, Defiant)",
      "speaker": "ROYAL GUARD",
