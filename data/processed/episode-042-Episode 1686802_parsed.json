      "end": "00:28.80",
      "start_seconds": 26.7,
      "end_seconds": 28.8,
      "duration_seconds": 2.1,
      "text": "Because we know who he is.",
      "source_line": 78
    },
    {
      "segment_id": "E42_S1_018",
      "scene_number": 1,
      "kind": "camera",
      "label": "CAMERA",
      "speaker": null,
