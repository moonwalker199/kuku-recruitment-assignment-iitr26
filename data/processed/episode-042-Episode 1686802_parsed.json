      "end": "01:04.00",
      "start_seconds": 62.0,
      "end_seconds": 64.0,
      "duration_seconds": 2.0,
      "text": "I have come home, Mother.",
      "source_line": 138
    },
    {
      "segment_id": "E42_S1_033",
      "scene_number": 1,
      "kind": "action",
      "label": "ACTION",
      "speaker": null,
      "delivery": null,
      "start": "01:04.00",
      "end": "01:12.50",
      "start_seconds": 64.0,
      "end_seconds": 72.5,
      "duration_seconds": 8.5,
      "text": "Alexander's mother turns toward the gathered nobility and guards, raising her chin and pointing proudly toward Alexander.",
      "source_line": 142
