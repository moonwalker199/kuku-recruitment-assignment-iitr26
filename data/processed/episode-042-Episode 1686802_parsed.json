    {
      "segment_id": "E42_S1_031",
      "scene_number": 1,
      "kind": "dialogue",
      "label": "ALEXANDER'S MOTHER (Tearful, Proud)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": "Tearful, Proud",
      "start": "00:54.00",
      "end": "01:01.80",
      "start_seconds": 54.0,
      "end_seconds": 61.8,
      "duration_seconds": 7.8,
      "text": "I saw you again... but seeing you like this... I see my son as he was always meant to be.",
