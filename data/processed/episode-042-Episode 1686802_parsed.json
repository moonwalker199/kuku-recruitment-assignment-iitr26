    {
      "segment_id": "E42_S1_037",
      "scene_number": 1,
      "kind": "dialogue",
      "label": "ALEXANDER (Grim, Vengeful)",
      "speaker": "ALEXANDER",
      "delivery": "Grim, Vengeful",
      "start": "01:13.80",
      "end": "01:17.50",
      "start_seconds": 73.8,
