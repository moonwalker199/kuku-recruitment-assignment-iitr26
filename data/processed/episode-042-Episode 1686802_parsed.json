      "source_line": 46
    },
    {
      "segment_id": "E42_S1_010",
      "scene_number": 1,
      "kind": "dialogue",
      "label": "BLOND NOBLEMAN (Furious, Hysterical)",
      "speaker": "BLOND NOBLEMAN",
