      "segment_id": "E42_S1_020",
      "scene_number": 1,
      "kind": "camera",
      "label": "CAMERA",
      "speaker": null,
      "delivery": null,
      "start": "00:30.40",
      "end": "00:33.80",
      "start_seconds": 30.4,
      "end_seconds": 33.8,
      "duration_seconds": 3.4,
      "text": "Medium close-up of Rupert gripping the edge of a pew for balance, his eyes wild with terror.",
      "source_line": 90
    },
