      "segment_id": "E42_S1_021",
      "scene_number": 1,
      "kind": "dialogue",
      "label": "BLOND NOBLEMAN (Denial, Shaken)",
      "speaker": "BLOND NOBLEMAN",
      "delivery": "Denial, Shaken",
      "start": "00:30.50",
      "end": "00:33.80",
      "start_seconds": 30.5,
      "end_seconds": 33.8,
      "duration_seconds": 3.3,
      "text": "You cannot be him. Alexander died!",
      "source_line": 94
    },
    {
      "segment_id": "E42_S1_022",
      "scene_number": 1,
      "kind": "camera",
      "label": "CAMERA",
      "speaker": null,
      "delivery": null,
      "start": "00:33.80",
      "end": "00:39.90",
      "start_seconds": 33.8,
      "end_seconds": 39.9,
      "duration_seconds": 6.1,
      "text": "Wide tracking shot behind Alexander as he advances down the center aisle, silhouetted against the ruins of the cathedral nave.",
      "source_line": 98
    },
    {
      "segment_id": "E42_S1_023",
      "scene_number": 1,
      "kind": "dialogue",
      "label": "ALEXANDER (Cold, Commanding)",
      "speaker": "ALEXANDER",
