      "segment_id": "E42_S1_034",
      "scene_number": 1,
      "kind": "dialogue",
      "label": "ALEXANDER'S MOTHER (Ringing, Authoritative)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": "Ringing, Authoritative",
      "start": "01:04.20",
      "end": "01:12.40",
      "start_seconds": 64.2,
      "end_seconds": 72.4,
      "duration_seconds": 8.2,
      "text": "Let everyone hear me! This is my son... Alexander Ashburn. The rightful Duke of Ashburn!",
      "source_line": 146
