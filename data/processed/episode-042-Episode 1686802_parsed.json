      "end": "00:39.80",
      "start_seconds": 34.0,
      "end_seconds": 39.8,
      "duration_seconds": 5.8,
      "text": "And yet, here I stand. That is the lie you built your life upon.",
      "source_line": 102
    },
    {
      "segment_id": "E42_S1_024",
      "scene_number": 1,
      "kind": "camera",
      "label": "CAMERA",
      "speaker": null,
