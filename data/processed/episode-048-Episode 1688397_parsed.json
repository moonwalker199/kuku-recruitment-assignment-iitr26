  },
  "scenes": [
    {
      "scene_number": 1,
      "heading": "INT. CATHERINE'S CHAMBERS – NIGHT",
      "start_seconds": 0.0,
      "end_seconds": 26.7,
      "segments": [
        {
          "segment_id": "E48_S1_001",
          "scene_number": 1,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:00.00",
          "end": "00:04.50",
          "start_seconds": 0.0,
          "end_seconds": 4.5,
          "duration_seconds": 4.5,
          "text": "Medium shot tracking slightly as Catherine stands beside a tall mullioned stone window, silhouetted against the moonlight over the distant castle spires.",
          "source_line": 14
        },
        {
          "segment_id": "E48_S1_002",
          "scene_number": 1,
          "kind": "action",
          "label": "ACTION",
          "speaker": null,
          "delivery": null,
          "start": "00:00.00",
          "end": "00:03.00",
          "start_seconds": 0.0,
          "end_seconds": 3.0,
          "duration_seconds": 3.0,
          "text": "Catherine, adorned in an ornate dark burgundy gown with braided golden hair, gazes out the dark window before turning slowly with a cold, venomous smirk.",
          "source_line": 18
        },
        {
          "segment_id": "E48_S1_003",
          "scene_number": 1,
          "kind": "dialogue",
          "label": "CATHERINE (Vindictive, Cold)",
          "speaker": "CATHERINE",
          "delivery": "Vindictive, Cold",
          "start": "00:02.40",
          "end": "00:07.50",
          "start_seconds": 2.4,
          "end_seconds": 7.5,
          "duration_seconds": 5.1,
          "text": "Two words, and that healer's crown rolls right back into the gutter where it belongs.",
          "source_line": 22
        },
        {
          "segment_id": "E48_S1_004",
          "scene_number": 1,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:04.50",
          "end": "00:08.50",
          "start_seconds": 4.5,
          "end_seconds": 8.5,
          "duration_seconds": 4.0,
          "text": "Close-up on Catherine's profile and jewelry as she speaks with calculating contempt.",
          "source_line": 26
        },
        {
          "segment_id": "E48_S1_005",
          "scene_number": 1,
          "kind": "action",
          "label": "ACTION",
          "speaker": null,
          "delivery": null,
          "start": "00:07.80",
          "end": "00:12.30",
          "start_seconds": 7.8,
          "end_seconds": 12.3,
          "duration_seconds": 4.5,
          "text": "Catherine glides across the chamber past a roaring stone hearth, picking up an orange from a silver platter on the table.",
          "source_line": 30
        },
        {
          "segment_id": "E48_S1_006",
          "scene_number": 1,
          "kind": "dialogue",
          "label": "CATHERINE (Scheming)",
          "speaker": "CATHERINE",
          "delivery": "Scheming",
          "start": "00:08.00",
          "end": "00:12.30",
          "start_seconds": 8.0,
          "end_seconds": 12.3,
          "duration_seconds": 4.3,
          "text": "Ten days. He gave himself ten days to fix it.",
          "source_line": 34
        },
        {
          "segment_id": "E48_S1_007",
          "scene_number": 1,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:12.30",
          "end": "00:20.00",
          "start_seconds": 12.3,
          "end_seconds": 20.0,
          "duration_seconds": 7.7,
          "text": "Medium close-up frontal shot of Catherine turning directly toward the viewer, her expression tightening into ruthless determination.",
          "source_line": 38
        },
        {
          "segment_id": "E48_S1_008",
          "scene_number": 1,
          "kind": "dialogue",
          "label": "CATHERINE (Intense, Measured)",
          "speaker": "CATHERINE",
          "delivery": "Intense, Measured",
          "start": "00:12.60",
          "end": "00:14.90",
          "start_seconds": 12.6,
          "end_seconds": 14.9,
          "duration_seconds": 2.3,
          "text": "Ten days for the council to sit.",
          "source_line": 42
        },
        {
          "segment_id": "E48_S1_009",
          "scene_number": 1,
          "kind": "action",
          "label": "ACTION",
          "speaker": null,
          "delivery": null,
          "start": "00:15.00",
          "end": "00:18.50",
          "start_seconds": 15.0,
          "end_seconds": 18.5,
          "duration_seconds": 3.5,
          "text": "Catherine raises a gloved index finger, emphasizing each point with sinister precision.",
          "source_line": 46
        },
        {
          "segment_id": "E48_S1_010",
          "scene_number": 1,
          "kind": "dialogue",
          "label": "CATHERINE (Calculating)",
          "speaker": "CATHERINE",
          "delivery": "Calculating",
          "start": "00:15.10",
          "end": "00:17.20",
          "start_seconds": 15.1,
          "end_seconds": 17.2,
          "duration_seconds": 2.1,
          "text": "Ten days for witnesses to be gathered.",
          "source_line": 50
        },
        {
          "segment_id": "E48_S1_011",
          "scene_number": 1,
          "kind": "dialogue",
          "label": "CATHERINE (Dark, Threatening)",
          "speaker": "CATHERINE",
          "delivery": "Dark, Threatening",
          "start": "00:17.40",
          "end": "00:19.70",
          "start_seconds": 17.4,
          "end_seconds": 19.7,
          "duration_seconds": 2.3,
          "text": "Ten days for a decree to be undone.",
          "source_line": 54
        },
        {
          "segment_id": "E48_S1_012",
          "scene_number": 1,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:20.00",
          "end": "00:26.70",
          "start_seconds": 20.0,
          "end_seconds": 26.7,
          "duration_seconds": 6.7,
          "text": "Slight push-in on Catherine as she clenches her fist against her chest, her eyes blazing with malice.",
          "source_line": 58
        },
        {
          "segment_id": "E48_S1_013",
          "scene_number": 1,
          "kind": "dialogue",
          "label": "CATHERINE (Menacing, Resolute)",
          "speaker": "CATHERINE",
          "delivery": "Menacing, Resolute",
          "start": "00:20.10",
          "end": "00:23.70",
          "start_seconds": 20.1,
          "end_seconds": 23.7,
          "duration_seconds": 3.6,
          "text": "Ten days is not a wall, Alexander. It's a door.",
          "source_line": 62
        },
        {
          "segment_id": "E48_S1_014",
          "scene_number": 1,
          "kind": "dialogue",
          "label": "CATHERINE (Chillingly Calm)",
          "speaker": "CATHERINE",
          "delivery": "Chillingly Calm",
          "start": "00:23.90",
          "end": "00:26.50",
          "start_seconds": 23.9,
          "end_seconds": 26.5,
          "duration_seconds": 2.6,
          "text": "And doors can be closed from the other side.",
          "source_line": 66
        }
      ]
    },
    {
      "scene_number": 2,
      "heading": "INT. CATHERINE'S CHAMBERS – CONTINUOUS",
      "start_seconds": 26.7,
      "end_seconds": 80.0,
      "segments": [
        {
          "segment_id": "E48_S2_015",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:26.70",
          "end": "00:30.80",
          "start_seconds": 26.7,
          "end_seconds": 30.8,
          "duration_seconds": 4.1,
          "text": "Medium shot over Catherine's shoulder seated before her vanity mirror as the chamber door eases open and Agnes enters quietly.",
          "source_line": 77
        },
        {
          "segment_id": "E48_S2_016",
          "scene_number": 2,
          "kind": "action",
          "label": "ACTION",
          "speaker": null,
          "delivery": null,
          "start": "00:26.80",
          "end": "00:29.50",
          "start_seconds": 26.8,
          "end_seconds": 29.5,
          "duration_seconds": 2.7,
          "text": "Agnes, dressed in a grey maid's dress and white apron, steps inside with cautious hesitation and clasps her hands.",
          "source_line": 81
        },
        {
          "segment_id": "E48_S2_017",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "AGNES (Hushed, Submissive)",
          "speaker": "AGNES",
          "delivery": "Hushed, Submissive",
          "start": "00:29.20",
          "end": "00:30.80",
          "start_seconds": 29.2,
          "end_seconds": 30.8,
          "duration_seconds": 1.6,
          "text": "You sent for me, my lady?",
          "source_line": 85
        },
        {
          "segment_id": "E48_S2_018",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Commanding, Sharp)",
          "speaker": "CATHERINE",
          "delivery": "Commanding, Sharp",
          "start": "00:30.90",
          "end": "00:32.00",
          "start_seconds": 30.9,
          "end_seconds": 32.0,
          "duration_seconds": 1.1,
          "text": "Lock it.",
          "source_line": 89
        },
        {
          "segment_id": "E48_S2_019",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:32.00",
          "end": "00:33.90",
          "start_seconds": 32.0,
          "end_seconds": 33.9,
          "duration_seconds": 1.9,
          "text": "Close-up on Agnes's hands turning the ornate iron key in the wooden door's brass lock.",
          "source_line": 93
        },
        {
          "segment_id": "E48_S2_020",
          "scene_number": 2,
          "kind": "sound_fx",
          "label": "SOUND FX",
          "speaker": null,
          "delivery": null,
          "start": "00:32.30",
          "end": "00:33.80",
          "start_seconds": 32.3,
          "end_seconds": 33.8,
          "duration_seconds": 1.5,
          "text": "Heavy metallic click of an iron key latching into a deadbolt.",
          "source_line": 97
        },
        {
          "segment_id": "E48_S2_021",
          "scene_number": 2,
          "kind": "action",
          "label": "ACTION",
          "speaker": null,
          "delivery": null,
          "start": "00:34.00",
          "end": "00:36.50",
          "start_seconds": 34.0,
          "end_seconds": 36.5,
          "duration_seconds": 2.5,
          "text": "Catherine strides forward and firmly grasps Agnes by both hands, stepping uncomfortably close.",
          "source_line": 101
        },
        {
          "segment_id": "E48_S2_022",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:34.00",
          "end": "00:43.00",
          "start_seconds": 34.0,
          "end_seconds": 43.0,
          "duration_seconds": 9.0,
          "text": "Two-shot profile of Catherine towering over Agnes in the candlelight.",
          "source_line": 105
        },
        {
          "segment_id": "E48_S2_023",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Fierce, Hissing)",
          "speaker": "CATHERINE",
          "delivery": "Fierce, Hissing",
          "start": "00:34.20",
          "end": "00:37.10",
          "start_seconds": 34.2,
          "end_seconds": 37.1,
          "duration_seconds": 2.9,
          "text": "Everyone in that chapel saw me humiliated today.",
          "source_line": 109
        },
        {
          "segment_id": "E48_S2_024",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Spiteful, calculating)",
          "speaker": "CATHERINE",
          "delivery": "Spiteful, calculating",
          "start": "00:37.30",
          "end": "00:39.00",
          "start_seconds": 37.3,
          "end_seconds": 39.0,
          "duration_seconds": 1.7,
          "text": "Good. Let them remember it.",
          "source_line": 113
        },
        {
          "segment_id": "E48_S2_025",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Sinister, Predatory)",
          "speaker": "CATHERINE",
          "delivery": "Sinister, Predatory",
          "start": "00:39.20",
          "end": "00:43.00",
          "start_seconds": 39.2,
          "end_seconds": 43.0,
          "duration_seconds": 3.8,
          "text": "Grief makes people careless, and carelessness is exactly what I need from that household right now.",
          "source_line": 117
        },
        {
          "segment_id": "E48_S2_026",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:43.00",
          "end": "00:46.80",
          "start_seconds": 43.0,
          "end_seconds": 46.8,
          "duration_seconds": 3.8,
          "text": "Over-the-shoulder close-up on Agnes, her brow furrowed in anxious alarm.",
          "source_line": 121
        },
        {
          "segment_id": "E48_S2_027",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "AGNES (Anxious, Whispering)",
          "speaker": "AGNES",
          "delivery": "Anxious, Whispering",
          "start": "00:43.30",
          "end": "00:46.80",
          "start_seconds": 43.3,
          "end_seconds": 46.8,
          "duration_seconds": 3.5,
          "text": "My lady... the Duke has bailiffs watching every road out of the county.",
          "source_line": 125
        },
        {
          "segment_id": "E48_S2_028",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:46.80",
          "end": "00:51.50",
          "start_seconds": 46.8,
          "end_seconds": 51.5,
          "duration_seconds": 4.7,
          "text": "Close-up on Catherine, a smug, venomous smile spreading across her painted lips.",
          "source_line": 129
        },
        {
          "segment_id": "E48_S2_029",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Confident, Devious)",
          "speaker": "CATHERINE",
          "delivery": "Confident, Devious",
          "start": "00:47.00",
          "end": "00:51.30",
          "start_seconds": 47.0,
          "end_seconds": 51.3,
          "duration_seconds": 4.3,
          "text": "I'm not leaving the county, Agnes. I'm going back into that house.",
          "source_line": 133
        },
        {
          "segment_id": "E48_S2_030",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:51.50",
          "end": "00:58.20",
          "start_seconds": 51.5,
          "end_seconds": 58.2,
          "duration_seconds": 6.7,
          "text": "Medium tracking shot following Catherine as she releases Agnes and stalks across the room toward the window sill.",
          "source_line": 137
        },
        {
          "segment_id": "E48_S2_031",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Pleased, Scheming)",
          "speaker": "CATHERINE",
          "delivery": "Pleased, Scheming",
          "start": "00:52.00",
          "end": "00:55.00",
          "start_seconds": 52.0,
          "end_seconds": 55.0,
          "duration_seconds": 3.0,
          "text": "Father Thomas did his part beautifully today.",
          "source_line": 141
        },
        {
          "segment_id": "E48_S2_032",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Calculated, Demanding)",
          "speaker": "CATHERINE",
          "delivery": "Calculated, Demanding",
          "start": "00:55.20",
          "end": "00:58.20",
          "start_seconds": 55.2,
          "end_seconds": 58.2,
          "duration_seconds": 3.0,
          "text": "Now I need him to do a little more before that hearing convenes.",
          "source_line": 145
        },
        {
          "segment_id": "E48_S2_033",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "00:58.20",
          "end": "01:01.00",
          "start_seconds": 58.2,
          "end_seconds": 61.0,
          "duration_seconds": 2.8,
          "text": "Medium close-up of Agnes glancing nervously over her shoulder.",
          "source_line": 149
        },
        {
          "segment_id": "E48_S2_034",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "AGNES (Apprehensive)",
          "speaker": "AGNES",
          "delivery": "Apprehensive",
          "start": "00:58.50",
          "end": "01:00.60",
          "start_seconds": 58.5,
          "end_seconds": 60.6,
          "duration_seconds": 2.1,
          "text": "If someone sees him come to you...",
          "source_line": 153
        },
        {
          "segment_id": "E48_S2_035",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "01:01.00",
          "end": "01:06.90",
          "start_seconds": 61.0,
          "end_seconds": 66.9,
          "duration_seconds": 5.9,
          "text": "Close-up on Catherine spinning around from the window, her jaw set in terrifying firmness.",
          "source_line": 157
        },
        {
          "segment_id": "E48_S2_036",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Stern, Threatening)",
          "speaker": "CATHERINE",
          "delivery": "Stern, Threatening",
          "start": "01:01.80",
          "end": "01:04.00",
          "start_seconds": 61.8,
          "end_seconds": 64.0,
          "duration_seconds": 2.2,
          "text": "Then no one sees him.",
          "source_line": 161
        },
        {
          "segment_id": "E48_S2_037",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Authoritative)",
          "speaker": "CATHERINE",
          "delivery": "Authoritative",
          "start": "01:04.30",
          "end": "01:06.90",
          "start_seconds": 64.3,
          "end_seconds": 66.9,
          "duration_seconds": 2.6,
          "text": "That is precisely your job tonight.",
          "source_line": 165
        },
        {
          "segment_id": "E48_S2_038",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "01:06.90",
          "end": "01:13.50",
          "start_seconds": 66.9,
          "end_seconds": 73.5,
          "duration_seconds": 6.6,
          "text": "Medium shot as Catherine picks up a heavy velvet coin purse and places it firmly into Agnes's awaiting open palms.",
          "source_line": 169
        },
        {
          "segment_id": "E48_S2_039",
          "scene_number": 2,
          "kind": "sound_fx",
          "label": "SOUND FX",
          "speaker": null,
          "delivery": null,
          "start": "01:07.50",
          "end": "01:09.00",
          "start_seconds": 67.5,
          "end_seconds": 69.0,
          "duration_seconds": 1.5,
          "text": "Dull clinking of heavy gold coins inside a leather pouch.",
          "source_line": 173
        },
        {
          "segment_id": "E48_S2_040",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Hushed, Commanding)",
          "speaker": "CATHERINE",
          "delivery": "Hushed, Commanding",
          "start": "01:07.80",
          "end": "01:10.50",
          "start_seconds": 67.8,
          "end_seconds": 70.5,
          "duration_seconds": 2.7,
          "text": "Send for the priest. Tonight.",
          "source_line": 177
        },
        {
          "segment_id": "E48_S2_041",
          "scene_number": 2,
          "kind": "dialogue",
          "label": "CATHERINE (Firm, Final)",
          "speaker": "CATHERINE",
          "delivery": "Firm, Final",
          "start": "01:10.80",
          "end": "01:13.40",
          "start_seconds": 70.8,
          "end_seconds": 73.4,
          "duration_seconds": 2.6,
          "text": "And make sure no one sees him arrive.",
          "source_line": 181
        },
        {
          "segment_id": "E48_S2_042",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "01:13.50",
          "end": "01:16.80",
          "start_seconds": 73.5,
          "end_seconds": 76.8,
          "duration_seconds": 3.3,
          "text": "Wide shot of Agnes curtsying swiftly, stashing the pouch into her apron, and hurrying out through the heavy wooden door into the darkness.",
          "source_line": 185
        },
        {
          "segment_id": "E48_S2_043",
          "scene_number": 2,
          "kind": "camera",
          "label": "CAMERA",
          "speaker": null,
          "delivery": null,
          "start": "01:16.80",
          "end": "01:20.00",
          "start_seconds": 76.8,
          "end_seconds": 80.0,
          "duration_seconds": 3.2,
          "text": "Exterior shot looking through the dark diamond-paned window frame at Catherine standing motionless in the warm candlelight, staring outward into the night with cold, unyielding ambition as the scene fades to black.",
          "source_line": 189
        }
      ]
    }
  ],
