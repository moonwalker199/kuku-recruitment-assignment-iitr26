      "segment_id": "E48_S2_034",
      "scene_number": 2,
      "kind": "dialogue",
      "label": "AGNES (Apprehensive)",
      "speaker": "AGNES",
      "delivery": "Apprehensive",
      "start": "00:58.50",
      "end": "01:00.60",
      "start_seconds": 58.5,
      "end_seconds": 60.6,
      "duration_seconds": 2.1,
      "text": "If someone sees him come to you...",
      "source_line": 153
    },
    {
      "segment_id": "E48_S2_035",
      "scene_number": 2,
      "kind": "camera",
      "label": "CAMERA",
      "speaker": null,
      "delivery": null,
      "start": "01:01.00",
      "end": "01:06.90",
      "start_seconds": 61.0,
      "end_seconds": 66.9,
      "duration_seconds": 5.9,
      "text": "Close-up on Catherine spinning around from the window, her jaw set in terrifying firmness.",
      "source_line": 157
    },
    {
      "segment_id": "E48_S2_036",
      "scene_number": 2,
      "kind": "dialogue",
      "label": "CATHERINE (Stern, Threatening)",
      "speaker": "CATHERINE",
      "delivery": "Stern, Threatening",
      "start": "01:01.80",
      "end": "01:04.00",
      "start_seconds": 61.8,
      "end_seconds": 64.0,
      "duration_seconds": 2.2,
      "text": "Then no one sees him.",
      "source_line": 161
    },
    {
      "segment_id": "E48_S2_037",
      "scene_number": 2,
      "kind": "dialogue",
      "label": "CATHERINE (Authoritative)",
      "speaker": "CATHERINE",
      "delivery": "Authoritative",
      "start": "01:04.30",
      "end": "01:06.90",
      "start_seconds": 64.3,
      "end_seconds": 66.9,
      "duration_seconds": 2.6,
      "text": "That is precisely your job tonight.",
      "source_line": 165
    },
    {
      "segment_id": "E48_S2_038",
      "scene_number": 2,
      "kind": "camera",
      "label": "CAMERA",
      "speaker": null,
      "delivery": null,
      "start": "01:06.90",
      "end": "01:13.50",
      "start_seconds": 66.9,
      "end_seconds": 73.5,
      "duration_seconds": 6.6,
      "text": "Medium shot as Catherine picks up a heavy velvet coin purse and places it firmly into Agnes's awaiting open palms.",
      "source_line": 169
    },
    {
      "segment_id": "E48_S2_039",
      "scene_number": 2,
      "kind": "sound_fx",
      "label": "SOUND FX",
      "speaker": null,
      "delivery": null,
      "start": "01:07.50",
      "end": "01:09.00",
      "start_seconds": 67.5,
      "end_seconds": 69.0,
      "duration_seconds": 1.5,
      "text": "Dull clinking of heavy gold coins inside a leather pouch.",
      "source_line": 173
    },
    {
      "segment_id": "E48_S2_040",
      "scene_number": 2,
      "kind": "dialogue",
      "label": "CATHERINE (Hushed, Commanding)",
      "speaker": "CATHERINE",
      "delivery": "Hushed, Commanding",
      "start": "01:07.80",
      "end": "01:10.50",
      "start_seconds": 67.8,
      "end_seconds": 70.5,
      "duration_seconds": 2.7,
      "text": "Send for the priest. Tonight.",
      "source_line": 177
    },
    {
      "segment_id": "E48_S2_041",
      "scene_number": 2,
      "kind": "dialogue",
      "label": "CATHERINE (Firm, Final)",
      "speaker": "CATHERINE",
      "delivery": "Firm, Final",
      "start": "01:10.80",
      "end": "01:13.40",
      "start_seconds": 70.8,
      "end_seconds": 73.4,
      "duration_seconds": 2.6,
      "text": "And make sure no one sees him arrive.",
      "source_line": 181
    },
    {
      "segment_id": "E48_S2_042",
      "scene_number": 2,
      "kind": "camera",
      "label": "CAMERA",
      "speaker": null,
      "delivery": null,
      "start": "01:13.50",
      "end": "01:16.80",
      "start_seconds": 73.5,
      "end_seconds": 76.8,
      "duration_seconds": 3.3,
      "text": "Wide shot of Agnes curtsying swiftly, stashing the pouch into her apron, and hurrying out through the heavy wooden door into the darkness.",
      "source_line": 185
    },
    {
      "segment_id": "E48_S2_043",
      "scene_number": 2,
      "kind": "camera",
      "label": "CAMERA",
      "speaker": null,
      "delivery": null,
      "start": "01:16.80",
      "end": "01:20.00",
      "start_seconds": 76.8,
      "end_seconds": 80.0,
      "duration_seconds": 3.2,
      "text": "Exterior shot looking through the dark diamond-paned window frame at Catherine standing motionless in the warm candlelight, staring outward into the night with cold, unyielding ambition as the scene fades to black.",
